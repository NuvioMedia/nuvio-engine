+#ifndef TORRENT_WINDOWS
+	void posix_storage::nuvio_close_fds()
+	{
+		for (auto& slot : m_nuvio_fds)
+		{
+			if (slot.fd >= 0) ::close(slot.fd);
+			slot = nuvio_fd_slot{};
+		}
+	}
+
+	int posix_storage::nuvio_open_fd(file_index_t const idx, bool const writable
+		, storage_error& ec)
+	{
+		// a hit moves the slot to the front. A read-only slot can't serve a
+		// write; it is replaced by a read-write one below.
+		for (std::size_t i = 0; i < m_nuvio_fds.size(); ++i)
+		{
+			if (m_nuvio_fds[i].fd < 0 || m_nuvio_fds[i].file != idx) continue;
+			if (writable && !m_nuvio_fds[i].writable)
+			{
+				::close(m_nuvio_fds[i].fd);
+				m_nuvio_fds[i] = nuvio_fd_slot{};
+				break;
+			}
+			std::rotate(m_nuvio_fds.begin(), m_nuvio_fds.begin() + std::ptrdiff_t(i)
+				, m_nuvio_fds.begin() + std::ptrdiff_t(i) + 1);
+			return m_nuvio_fds[0].fd;
+		}
+
+		std::string const fn = files().file_path(idx, m_save_path);
+		int const base_flags = (writable ? O_RDWR : O_RDONLY)
+#ifdef O_CLOEXEC
+			| O_CLOEXEC
+#endif
+			;
+		int fd = -1;
+		do { fd = ::open(fn.c_str(), base_flags); } while (fd < 0 && errno == EINTR);
+		if (fd < 0)
+		{
+			ec.ec.assign(errno, generic_category());
+			if (writable && ec.ec == boost::system::errc::no_such_file_or_directory)
+			{
+				// the directory the file is in probably doesn't exist yet
+				ec.ec.clear();
+				create_directories(parent_path(fn), ec.ec);
+				if (ec.ec)
+				{
+					ec.file(idx);
+					ec.operation = operation_t::mkdir;
+					return -1;
+				}
+				do { fd = ::open(fn.c_str(), base_flags | O_CREAT | O_TRUNC, 0666); }
+				while (fd < 0 && errno == EINTR);
+				if (fd >= 0) ec.ec.clear();
+				else ec.ec.assign(errno, generic_category());
+			}
+			if (fd < 0)
+			{
+				ec.file(idx);
+				ec.operation = operation_t::file_open;
+				return -1;
+			}
+		}
+
+		// drop the least recently used descriptor and insert at the front
+		if (m_nuvio_fds.back().fd >= 0) ::close(m_nuvio_fds.back().fd);
+		std::rotate(m_nuvio_fds.begin(), m_nuvio_fds.end() - 1, m_nuvio_fds.end());
+		m_nuvio_fds[0] = nuvio_fd_slot{fd, idx, writable};
+		return fd;
+	}
+#endif
